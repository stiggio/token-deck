#!/usr/bin/env node
/**
 * Fails if a Söhne file or any non-Geist font is tracked or packaged.
 * PLAN.md section 2.
 */
const { execSync } = require('child_process')
const fs = require('fs')
const path = require('path')

let fail = false
const bad = (msg) => {
  console.error(`lint-fonts: ${msg}`)
  fail = true
}

function tracked() {
  try {
    return execSync('git ls-files -z', { encoding: 'utf8' }).split('\0').filter(Boolean)
  } catch {
    return []
  }
}

const files = tracked()
const fontExt = /\.(woff2?|otf|ttf)$/i

for (const f of files) {
  if (/soehne|söhne/i.test(f)) bad(`tracked path matches a Söhne name: ${f}`)
  if (fontExt.test(f)) {
    const geistBrand = f.startsWith('brand-kit/brand/geist/') || f.startsWith('assets/brand/geist/')
    const geistRes = f.startsWith('resources/') && /geist/i.test(f)
    if (!geistBrand && !geistRes) bad(`font file outside Geist paths: ${f}`)
  }
  if ((f.startsWith('src/') || f.startsWith('resources/')) && fs.existsSync(f) && fs.statSync(f).isFile()) {
    if (fontExt.test(f)) continue
    let text = ''
    try {
      text = fs.readFileSync(f)
    } catch {
      continue
    }
    if (text.includes(0)) continue
    if (/soehne/i.test(text.toString('utf8'))) bad(`soehne string in ${f}`)
  }
}

function walk(dir, out = []) {
  if (!fs.existsSync(dir)) return out
  for (const name of fs.readdirSync(dir)) {
    const p = path.join(dir, name)
    const st = fs.statSync(p)
    if (st.isDirectory()) walk(p, out)
    else out.push(p)
  }
  return out
}

for (const root of ['dist', 'out']) {
  for (const p of walk(root)) {
    if (!fontExt.test(p)) continue
    if (!/geist/i.test(p)) bad(`non-Geist font in packaged output: ${p}`)
  }
}

if (fail) process.exit(1)
console.log('lint-fonts: ok')
